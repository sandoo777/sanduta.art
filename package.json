{
    "name": "sanduta.art",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsx server.ts",
        "dev:next": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
        "build": "next build",
        "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsx server.ts",
        "start:next": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "npm run jest-only",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:unit": "vitest src/tests/unit --run",
        "test:integration": "vitest src/tests/integration --run",
        "test:api": "vitest src/tests/api --run",
        "test:security": "playwright test -c playwright.security.config.ts",
        "test:e2e": "playwright test",
        "test:e2e:materials": "playwright test src/tests/e2e/materials-regression.spec.ts",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:perf": "lhci autorun",
        "test:all": "npm run test:unit && npm run test:integration && npm run test:api && npm run test:security && npm run test:e2e && npm run test:perf",
        "playwright:install": "playwright install --with-deps",
        "postinstall": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:generate": "prisma generate",
        "prisma:studio": "prisma studio",
        "prisma:seed": "prisma db seed",
        "seed:materials": "tsx prisma/seeds/seed-materials.ts",
        "seed:production-methods": "tsx scripts/seed-production-methods.ts",
        "backup:full": "tsx src/modules/backup/cli.ts create --type=full",
        "backup:db": "tsx src/modules/backup/cli.ts create --type=database",
        "backup:files": "tsx src/modules/backup/cli.ts create --type=files",
        "backup:config": "tsx src/modules/backup/cli.ts create --type=config",
        "backup:list": "tsx src/modules/backup/cli.ts list",
        "backup:restore": "tsx src/modules/backup/cli.ts restore",
        "backup:test": "tsx src/modules/backup/testBackupRestore.ts",
        "backup:health": "tsx src/modules/backup/cli.ts health",
        "backup:cleanup": "tsx src/modules/backup/cli.ts cleanup",
        "version:generate": "node scripts/generateVersion.js",
        "version:update": "node scripts/generateVersion.js --update-package",
        "changelog:generate": "tsx scripts/generateChangelog.ts",
        "smoke-tests": "node scripts/smokeTests.js",
        "health-check": "node scripts/healthCheck.js",
        "deploy:monitor": "node scripts/monitorDeployment.js",
        "deploy:notify": "node scripts/notifyDeployment.js",
        "flags:list": "tsx src/modules/flags/useFeatureFlags.ts list",
        "flags:enable": "tsx src/modules/flags/useFeatureFlags.ts enable",
        "flags:disable": "tsx src/modules/flags/useFeatureFlags.ts disable",
        "flags:rollout": "tsx src/modules/flags/useFeatureFlags.ts rollout",
        "monitoring:test": "vitest src/__tests__/monitoring.test.ts --run",
        "monitoring:dashboard": "echo 'Open http://localhost:3000/dashboard/monitoring'",
        "pre-launch:audit": "tsx scripts/pre-launch-audit.ts",
        "pre-launch:performance": "tsx scripts/performance-test.ts",
        "launch": "tsx scripts/launch.ts",
        "smoke-tests:full": "tsx scripts/smoke-tests.ts",
        "monitor:post-launch": "tsx scripts/post-launch-monitor.ts",
        "hotfix": "tsx scripts/hotfix.ts",
        "rollback": "tsx scripts/hotfix.ts rollback",
        "start-test-server": "node scripts/start-test-server.js"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.1",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.2.2",
        "@node-rs/argon2": "^2.0.2",
        "@prisma/adapter-pg": "^7.2.0",
        "@react-email/components": "^1.0.3",
        "@types/bcryptjs": "^2.4.6",
        "@types/pdfkit": "^0.17.4",
        "@upstash/qstash": "^2.8.4",
        "@upstash/redis": "^1.36.1",
        "bcryptjs": "^3.0.3",
        "date-fns": "^4.1.0",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "framer-motion": "^12.23.26",
        "html2canvas": "^1.4.1",
        "isomorphic-dompurify": "^2.35.0",
        "jspdf": "^4.0.0",
        "lucide-react": "^0.562.0",
        "msw": "^2.15.0",
        "next": "^15.5.9",
        "next-auth": "^4.24.13",
        "otplib": "^12.0.1",
        "pdfkit": "^0.17.2",
        "pg": "^8.16.3",
        "qrcode": "^1.5.4",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.71.1",
        "react-hot-toast": "^2.6.0",
        "recharts": "^3.6.0",
        "resend": "^6.6.0",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "sonner": "^2.0.7",
        "speakeasy": "^2.0.0",
        "zod": "^4.3.5",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.0",
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-react": "^8.0.1",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.57.0",
        "@prisma/client": "7.3.0",
        "@tailwindcss/postcss": "^4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.1",
        "@testing-library/user-event": "^14.6.4",
        "@types/jest": "^30.0.0",
        "@types/node": "^20",
        "@types/pg": "^8.16.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/speakeasy": "^2.0.10",
        "@types/supertest": "^6.0.3",
        "@types/testing-library__dom": "^7.0.2",
        "@vitejs/plugin-react": "^5.1.2",
        "@vitest/ui": "^4.0.16",
        "babel-jest": "^30.4.1",
        "babel-plugin-react-compiler": "1.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^9",
        "eslint-config-next": "16.1.1",
        "happy-dom": "^20.0.11",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jest-environment-node": "^30.4.1",
        "lighthouse": "^13.0.1",
        "prisma": "7.3.0",
        "supertest": "^7.2.2",
        "tailwindcss": "^4",
        "ts-jest": "^29.4.12",
        "tsx": "^4.21.0",
        "typescript": "^5",
        "vitest": "^4.0.16"
    }
}
